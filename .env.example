# Keep mint blank until a token is supplied. The community program is deployed
# on Testnet; quests and advisory proposals do not require a token mint.
VITE_SOLANA_TOKEN_MINT=
VITE_SOLANA_PROGRAM_ID_DEVNET=
VITE_SOLANA_PROGRAM_ID_TESTNET=D7nYqa5Y1a2MQqDQb1NpU5kVS7TxDrj92mbCY9UitHq6
VITE_SOLANA_PROGRAM_ID_MAINNET=
# Used only when selecting a custom RPC cluster.
VITE_SOLANA_PROGRAM_ID=

# Testnet is the default while this site is connected to the test deployment.
VITE_SOLANA_CLUSTER=testnet
VITE_SOLANA_RPC_URL=https://api.testnet.solana.com
VITE_EXPLORER_URL=https://explorer.solana.com

# Optional treasury wallet owner public key (not an SPL token account).
VITE_TREASURY_ADDRESS=

# Optional display labels; live mint decimals are read from Solana RPC.
VITE_TOKEN_NAME=
VITE_TOKEN_SYMBOL=
VITE_TOKEN_DECIMALS=9
